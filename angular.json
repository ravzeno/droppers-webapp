{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "droppers": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/droppers",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ],
            "assets": [
              "src/manifest.webmanifest",
              "src/sw.js",
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "optimization": {
              "fonts": {
                "inline": false
              }
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "droppers:build"
          }
        }
      }
    },
    "droppers-device": {
      "projectType": "application",
      "root": "device",
      "sourceRoot": "device/src",
      "prefix": "device",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/droppers-device",
            "index": "device/index.html",
            "browser": "device/src/main.ts",
            "tsConfig": "device/tsconfig.app.json",
            "styles": [
              "device/src/styles.css"
            ],
            "assets": [],
            "optimization": {
              "fonts": {
                "inline": false
              }
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "droppers-device:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "0ab26814-974b-458c-83a5-a974c8be0978"
  }
}
